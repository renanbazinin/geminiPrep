# Gemini Developer API (used only when the Gemini provider is selected)
GEMINI_API_KEY=your_key_here
GEMINI_API_VERSION=v1beta
GEMINI_CHAT_MODELS=gemini-3.7-flash,gemini-2.5-flash,gemini-2.5-flash-lite,gemini-2.5-pro

# Vertex AI chat. Authentication uses Application Default Credentials:
#   gcloud auth application-default login
GCP_PROJECT=your_google_cloud_project
VERTEX_CHAT_MODELS=gemini-3.7-flash,gemini-3.6-flash,gemini-2.5-flash
VERTEX_CHAT_DEFAULT_REGION=global

# Explicit context caching lab (defaults follow the currently documented Gemini 3 support list)
# Override this when Google adds a new explicitly-cacheable model.
VERTEX_CACHE_MODELS=gemini-3.6-flash,gemini-3.5-flash-lite,gemini-3.5-flash,gemini-3.1-pro-preview,gemini-3.1-flash-lite,gemini-3-flash-preview
VERTEX_CACHE_DEFAULT_REGION=global

# Regions test catalogs. Unknown IDs are accepted and shown using their raw ID.
# The built-in list also includes Flash Image models (gemini-3.1-flash-image,
# gemini-3.1-flash-lite-image, gemini-2.5-flash-image). Image probes request IMAGE
# output and consume more quota than text probes.
VERTEX_PROBE_MODELS=gemini-3.7-flash,gemini-3.6-flash,gemini-2.5-flash,gemini-3.1-flash-image,gemini-3.1-flash-lite-image,gemini-2.5-flash-image
VERTEX_PROBE_REGIONS=global,eu,europe-west2,europe-west4
VERTEX_PROBE_DEFAULT_REGIONS=global,eu
VERTEX_PROBE_TIMEOUT_MS=30000
VERTEX_PROBE_CONCURRENCY=8

# Local server
PORT=3001
