# Copy this file to .env and fill in the provider and Jira settings you use.
# Never commit .env or .env.jira.local. Never prefix secrets with VITE_.
# Select your model provider in the application's Settings page.

# Gemini Developer API (used only when the Gemini provider is selected)
GEMINI_API_KEY=your_key_here
GEMINI_API_VERSION=v1beta
GEMINI_CHAT_MODELS=gemini-3.8-flash,gemini-3.7-flash,gemini-2.5-flash,gemini-2.5-flash-lite,gemini-2.5-pro

# Vertex AI chat. Authentication uses Application Default Credentials:
#   gcloud auth application-default login
GCP_PROJECT=your_google_cloud_project
# Optional alternative to gcloud's local Application Default Credentials:
# GOOGLE_APPLICATION_CREDENTIALS=C:/secure/google-service-account.json
# GCP_PROJECT also accepts these fallback aliases (only one is needed):
# GOOGLE_CLOUD_PROJECT, GCLOUD_PROJECT, GCP_PROJECT_ID.
VERTEX_CHAT_MODELS=gemini-3.8-flash,gemini-3.7-flash,gemini-3.6-flash,gemini-2.5-flash
VERTEX_CHAT_DEFAULT_REGION=global

# Explicit context caching lab (defaults follow the currently documented Gemini 3 support list)
# Override this when Google adds a new explicitly-cacheable model.
VERTEX_CACHE_MODELS=gemini-3.6-flash,gemini-3.5-flash-lite,gemini-3.5-flash,gemini-3.1-pro-preview,gemini-3.1-flash-lite,gemini-3-flash-preview
VERTEX_CACHE_DEFAULT_REGION=global

# Regions test catalogs. Unknown IDs are accepted and shown using their raw ID.
# The built-in list also includes Gemini Image models (gemini-3.1-flash-image,
# gemini-3.1-flash-lite-image, gemini-3-pro-image, gemini-2.5-flash-image). Image probes request IMAGE
# output and consume more quota than text probes.
VERTEX_PROBE_MODELS=gemini-3.8-flash,gemini-3.7-flash,gemini-3.6-flash,gemini-2.5-flash,gemini-3.1-flash-image,gemini-3.1-flash-lite-image,gemini-3-pro-image,gemini-2.5-flash-image
VERTEX_PROBE_REGIONS=global,eu,europe-west2,europe-west4
VERTEX_PROBE_DEFAULT_REGIONS=global,eu
VERTEX_PROBE_TIMEOUT_MS=30000
VERTEX_PROBE_CONCURRENCY=8

# Jira space (server-side only; required for live tickets and Jira chat actions)
# Use the email of the Atlassian account that created the API token.
# Scoped token permissions: read:jira-work, write:jira-work, read:jira-user.
# Create a token: https://id.atlassian.com/manage-profile/security/api-tokens
JIRA_SITE_URL=https://your-site.atlassian.net
JIRA_EMAIL=you@example.com
JIRA_API_TOKEN=your_jira_api_token_here
JIRA_PROJECT_KEY=DESK
# Scoped tokens use the Atlassian gateway and your site's cloud ID:
# Find the cloud ID at https://your-site.atlassian.net/_edge/tenant_info
JIRA_API_BASE_URL=https://api.atlassian.com/ex/jira/your-cloud-id
# For an unscoped token, set JIRA_API_BASE_URL to the JIRA_SITE_URL instead.
# The demo's Connect Jira form saves credentials to .env.jira.local.
# Values in .env.jira.local override the corresponding Jira values in .env.
# Remove/update that local override when changing accounts or rotating a token.
# The connection form targets the prepared DeskFlow site; configure other sites here.

# Local server (Vite's development proxy targets 3001; update vite.config.ts if changed)
PORT=3001
